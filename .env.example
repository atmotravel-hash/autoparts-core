# AutoParts Core — copy to .env and fill as needed.
# The application starts without any of these optional credentials.

DEMO_MODE=true
ENABLE_LIVE_GRAPHQL=true
INCLUDE_FIXTURE_IN_LIVE_SEARCH=false
DATABASE_URL=sqlite:///./data/autoparts.db
DEFAULT_CURRENCY=EUR
DESTINATION_COUNTRY=UA
LOG_LEVEL=INFO

# Optional discovery
BRAVE_SEARCH_API_KEY=

# Optional marketplace APIs (authorized access only)
EBAY_APP_ID=
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=

# Optional FX / VIN providers
FX_API_KEY=
VIN_DECODE_API_KEY=

REQUEST_TIMEOUT_SECONDS=20
MAX_RESULTS_PER_QUERY=50
MAX_PAGES_PER_DOMAIN=5
MAX_CONCURRENT_REQUESTS=4
REQUEST_DELAY_SECONDS=0.5
RETRY_LIMIT=3
JOB_QUEUE_MAX=200
LISTING_FRESHNESS_HOURS=72
